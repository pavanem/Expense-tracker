# Copy this file to .env and adjust as needed. docker-compose reads .env
# automatically from the project root.

# ---- Database ----
DB_NAME=expense_tracker
DB_USERNAME=expense_user
DB_PASSWORD=change_me_before_deploying
# Host port Postgres is published on (container always uses 5432 internally).
DB_HOST_PORT=5432

# ---- Backend ----
SPRING_PROFILES_ACTIVE=prod
# Origins allowed to call the API. Set to https://<your-actual-domain> —
# must match DOMAIN below exactly (scheme + host, no trailing slash).
# Only use an http:// / localhost value here if you are NOT exposing this
# publicly (LAN/Tailscale-only deployment instead).
CORS_ALLOWED_ORIGINS=https://pavan-expense.duckdns.org
# Enforces JWT auth on every /api/** endpoint except register/login/refresh.
# Requires a real JWT_SECRET (see below) — the app refuses to start with
# this true and the placeholder secret still in place. Only set this true
# once you're ready to actually use the app with a login (see the auth
# module in BUILD_PROGRESS.md).
SECURITY_ENABLED=true
BACKEND_JAVA_OPTS=-Xms256m -Xmx512m

# ---- Auth / JWT ----
# REQUIRED once SECURITY_ENABLED=true. Generate with: openssl rand -base64 64
# Do not reuse the placeholder below — the app will refuse to start on it
# once security is enabled.
JWT_SECRET=CHANGE_ME_INSECURE_DEFAULT_DO_NOT_USE_IN_PRODUCTION_1234567890
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30
# Requires real HTTPS to work at all — browsers silently drop Secure
# cookies over plain HTTP, which would break login entirely. true is
# correct once Phase 1 (DuckDNS + Let's Encrypt) is live; set to false only
# if you are running LAN/Tailscale-only without TLS in front.
JWT_COOKIE_SECURE=true
# Account lockout after repeated failed logins — defense-in-depth alongside
# Nginx's per-IP rate limiting (which a distributed attempt could dodge).
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ---- Monitoring alerts (Phase 5) ----
# Push notifications via ntfy.sh — free, no account needed. Install the
# "ntfy" app on your phone (Android/iOS) and subscribe to this exact topic
# name to receive alerts for backup failures and TLS certificate renewal
# problems (via scripts/monitoring/).
#
# NOTE: fail2ban's own ban notifications are configured separately in
# scripts/hardening/jail.local's ntfy_topic setting — fail2ban runs as its
# own systemd service and doesn't read this .env file. Use the SAME topic
# name in both places.
#
# IMPORTANT: ntfy.sh topics are public unless you pick an unguessable name
# — anyone who knows this string can read your notifications (and could
# spam fake ones to it). Use something long and random, NOT something
# obvious like "pavan-expense-alerts". Generate one with:
#   openssl rand -hex 16
NTFY_TOPIC=change-me-to-a-long-random-unguessable-string

# ---- Monitoring (Phase 5) ----
# Free push notifications via https://ntfy.sh — no account needed, just
# pick a unique, hard-to-guess topic name (treat it like a password) and
# subscribe to it in the ntfy app. Used by scripts/hardening/check-cert-expiry.sh.
# fail2ban's ntfy action (scripts/hardening/jail.local) sets its own topic
# separately, since fail2ban config isn't read from this .env file.
NTFY_TOPIC=your-unique-topic-name-here

# ---- Frontend ----
# Public HTTPS deployment (Phase 1 of the public-hardening work) fixes
# Nginx to standard ports 80 (redirect + ACME challenge only) and 443
# (the actual app) — Let's Encrypt's HTTP-01 challenge and every browser
# both expect those exact ports, so FRONTEND_HOST_PORT is no longer
# configurable. Your router must forward both 80 and 443 to this machine.

# ---- Public domain (DuckDNS + Let's Encrypt) ----
# 1. Create a free hostname at https://www.duckdns.org (e.g. "pavan-expense"
#    -> pavan-expense.duckdns.org), and grab your token from that same page.
# 2. Fill in DOMAIN/DUCKDNS_SUBDOMAIN/DUCKDNS_TOKEN/CERTBOT_EMAIL below.
# 3. Forward ports 80 and 443 on your router to this server's LAN IP.
# 4. Run: docker compose up -d duckdns   (wait a minute for the DNS record)
# 5. Run: ./scripts/init-letsencrypt.sh   (one-time — obtains the real cert)
# 6. Run: docker compose up -d --build   (starts everything else)
DOMAIN=pavan-expense.duckdns.org
DUCKDNS_SUBDOMAIN=pavan-expense
DUCKDNS_TOKEN=your-duckdns-token-here
CERTBOT_EMAIL=you@example.com
