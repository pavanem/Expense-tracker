# Copy this file to .env and adjust as needed. docker-compose reads .env
# automatically from the project root.

# ---- Database ----
DB_NAME=expense_tracker
DB_USERNAME=expense_user
DB_PASSWORD=change_me_before_deploying
# Host port Postgres is published on (container always uses 5432 internally).
DB_HOST_PORT=5432

# ---- Backend ----
SPRING_PROFILES_ACTIVE=prod
# Origins allowed to call the API. When served through the bundled Nginx on
# the default port, http://<server-ip> (port 80) is what the browser sees.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
# v1 ships with authentication disabled per the SRS; flip to true once
# JWT/OAuth2 is wired into SecurityConfig.
SECURITY_ENABLED=false
BACKEND_JAVA_OPTS=-Xms256m -Xmx512m

# ---- Frontend ----
# Host port the Nginx container (serving the SPA + reverse proxy) is published on.
FRONTEND_HOST_PORT=80
