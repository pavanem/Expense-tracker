# TEMPLATE — envsubst substitutes ${DOMAIN} at container start (official
# Nginx image behavior for anything under /etc/nginx/templates/). Nginx's
# own runtime variables ($host, $remote_addr, etc.) are untouched since
# they aren't real environment variables.
#
# DEPLOYMENT MODES:
#   LAN / HTTP-only (current):  Port 80 serves the app directly.
#                               DOMAIN defaults to "_" (catch-all) when unset.
#   Public HTTPS (future):      Set DOMAIN in .env, obtain certs via
#                               scripts/init-letsencrypt.sh, then uncomment
#                               the port 443 block below and change the port
#                               80 block to redirect-only (see comment there).

# ---- http-context directives ------------------------------------------------

server_tokens off;

# Rate limiting, keyed by client IP:
#  - auth_zone: 5 req/min for login & register — slows credential stuffing
#    without affecting normal use. burst=3 for double-clicks/retries.
#  - general_zone: 60 req/min for all other /api/ calls.
limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=general_zone:10m rate=60r/m;
limit_req_status 429;

limit_conn_zone $binary_remote_addr zone=conn_zone:10m;
limit_conn_status 429;

# ---- Port 80: serves the application (HTTP / LAN mode) ----------------------
# For public HTTPS deployment, replace the body of this block with:
#   location /.well-known/acme-challenge/ { root /var/www/certbot; }
#   location / { return 301 https://$host$request_uri; }
# and uncomment the port 443 server block below.
server {
    listen 80;
    server_name ${DOMAIN};

    # ACME challenge path — safe to keep even in HTTP mode; does nothing
    # unless certbot is actively running a challenge.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/security-headers.conf;

    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 10s;
    keepalive_timeout 15s;

    limit_conn conn_zone 30;

    root /usr/share/nginx/html;
    index index.html;

    # Static assets: long cache + immutable (Vite content-hashes the filenames)
    location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        # Re-include security headers: add_header does not inherit into a
        # location block that sets its own add_header directives.
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # SPA fallback — React Router handles client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Auth endpoints — tight rate limit (credential stuffing target)
    location = /api/auth/login {
        limit_req zone=auth_zone burst=3 nodelay;
        include /etc/nginx/proxy-common.conf;
    }

    location = /api/auth/register {
        limit_req zone=auth_zone burst=3 nodelay;
        include /etc/nginx/proxy-common.conf;
    }

    # All other API traffic — generous limit, still a real ceiling
    location /api/ {
        limit_req zone=general_zone burst=20 nodelay;
        include /etc/nginx/proxy-common.conf;
    }

    location /swagger-ui/ {
        limit_req zone=general_zone burst=20 nodelay;
        include /etc/nginx/proxy-common.conf;
    }

    location /api-docs {
        limit_req zone=general_zone burst=20 nodelay;
        include /etc/nginx/proxy-common.conf;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;
}

